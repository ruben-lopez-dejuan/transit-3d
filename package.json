{
  "name": "transit-3d",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "test:bizkaibus-gtfs": "tsx server/test-bizkaibus-gtfs.ts",
    "test:bizkaibus-realtime": "tsx server/test-bizkaibus-realtime.ts",
    "test:core": "tsx --test server/transit/core.test.ts server/transit/plans.test.ts server/transit/parser.test.ts server/transit/renfe.test.ts server/transit/realtime.test.ts server/transit/bilbobus.test.ts",
    "test:frontend": "tsx --test src/transit/frontend.test.ts src/transit/gpsMotion.test.ts src/map/vehicleLod.test.ts",
    "test:network": "tsx server/test-network.ts",
    "test": "npm run test:core && npm run test:frontend"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "maplibre-gl": "^6.11.2",
    "proj4": "^2.22.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
