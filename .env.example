# Optional server credentials from EMT Madrid / MobilityLabs registration.
# Set both variables in the server process environment before starting it.
# This project does not automatically load .env files.
# Never use VITE_* names or put these credentials into a city package.
EMT_CLIENT_ID=
EMT_PASSKEY=
NAP_API_KEY=
# Optional protection for the read-only diagnostics console at /admin.
TRANSIT_ADMIN_TOKEN=
